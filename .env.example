# Copy to .env.local and fill in. Never commit .env.local.

# --- Core -------------------------------------------------------------------
DATABASE_URI=
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Public origin used to build absolute URLs — canonicals, OG/Twitter images, JSON-LD.
# No trailing slash. Falls back to http://localhost:3000 when unset (src/lib/seo/metadata.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password given to every account created by `npm run seed`. At least 12 characters.
# Development only — the seed script refuses to run with NODE_ENV=production.
SEED_PASSWORD=

# --- Payments (J4) ----------------------------------------------------------
# Which gateway to use: `stub` (default) or `razorpay` (not implemented until J11).
# The stub refuses to start when NODE_ENV=production — see src/lib/payments/factory.ts.
PAYMENT_PROVIDER=stub

# Secret the webhook signature is verified against. The stub signs its own callbacks with this,
# so signature verification is real in development too. Falls back to a development constant
# when unset; must be set to the provider's own secret before going live.
PAYMENT_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Shipping (J5) ----------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- Scheduler (J5) ---------------------------------------------------------
# Shared secret required by every /api/cron/* route
CRON_SECRET=

# --- Email (J6) -------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# --- WhatsApp, Meta Cloud API (J6) ------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- AI assistant (J7) ------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Media storage (J10) ----------------------------------------------------
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
