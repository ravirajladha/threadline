# Copy to .env.local and fill in. Never commit .env.local.

# --- Core -------------------------------------------------------------------
DATABASE_URI=
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Payments (J4) ----------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shipping (J5) ----------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- Scheduler (J5) ---------------------------------------------------------
# Shared secret required by every /api/cron/* route
CRON_SECRET=

# --- Email (J6) -------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# --- WhatsApp, Meta Cloud API (J6) ------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- AI assistant (J7) ------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Media storage (J10) ----------------------------------------------------
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
