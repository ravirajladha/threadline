# Copy to .env.local and fill in. Never commit .env.local.

# --- Core -------------------------------------------------------------------
DATABASE_URI=
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Public origin used to build absolute URLs — canonicals, OG/Twitter images, JSON-LD.
# No trailing slash. Falls back to http://localhost:3000 when unset (src/lib/seo/metadata.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password given to every account created by `npm run seed`. At least 12 characters.
# Development only — the seed script refuses to run with NODE_ENV=production.
SEED_PASSWORD=

# --- Payments (J4) ----------------------------------------------------------
# Which gateway to use: `stub` (default) or `razorpay` (not implemented until J11).
# The stub refuses to start when NODE_ENV=production — see src/lib/payments/factory.ts.
PAYMENT_PROVIDER=stub

# Secret the webhook signature is verified against. The stub signs its own callbacks with this,
# so signature verification is real in development too. Falls back to a development constant
# when unset; must be set to the provider's own secret before going live.
PAYMENT_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Shipping (J5) ----------------------------------------------------------
# Which courier to use: `stub` (default) or `shiprocket` (not implemented until J11).
# The stub refuses to start when NODE_ENV=production — see src/lib/shipping/factory.ts.
SHIPPING_PROVIDER=stub

# Secret the tracking webhook signature is verified against. The stub signs its own callbacks with
# this, so signature verification is real in development too. Falls back to a development constant
# when unset; must be set to the provider's own secret before going live.
SHIPPING_WEBHOOK_SECRET=

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- Networking -------------------------------------------------------------
# How many proxies in front of the app we control, and therefore trust to have rewritten
# `x-forwarded-for`. The rate limiter counts this many entries from the RIGHT of that header to find
# the real client, because the left-hand entries are whatever the caller sent.
#
#   1  Railway's edge alone — the default, and correct for the current deployment
#   2  a proxy of ours in front of Railway (Cloudflare proxying a custom domain, say)
#   0  no proxy at all: the header is untrustworthy, so every caller shares one bucket
#
# Getting this too low leaves the limiter bypassable by setting the header; too high buckets every
# visitor behind the same edge node together and starts refusing real shoppers.
TRUSTED_PROXY_HOPS=1

# --- Scheduler (J5) ---------------------------------------------------------
# Shared secret required by every /api/cron/* route. Present it as `Authorization: Bearer <secret>`
# or in an `x-cron-secret` header. A job runs with no user and full authority, so this is the whole
# of the authentication — and an unset value refuses every request rather than allowing them.
# A wrong secret and an unknown job name both answer 404, so the route confirms neither.
CRON_SECRET=

# --- Auth (J8) ---------------------------------------------------------------
# Which channel delivers sign-in codes. `stub` accepts the fixed code 000000 and prints it to the
# server console — and is refused in production, because a stub here hands every account to anyone
# who can type six zeroes. A real provider lands at J11. Unset means stub.
OTP_PROVIDER=

# --- Notifications (J6) ------------------------------------------------------
# Which channel delivers messages. `console` renders and prints them, and is refused in
# production — a shop that logs its confirmations instead of sending them looks healthy while no
# customer hears anything. `resend` lands at J11. Unset means console.
NOTIFICATION_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# --- WhatsApp, Meta Cloud API (J6) ------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- AI assistant (J7) ------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Media storage ----------------------------------------------------------
# S3-compatible object storage for uploads. Currently Cloudflare R2, which speaks the S3 API.
#
# Leave these empty in local development and Payload writes to a `media/` folder instead, which
# is fine on one machine. In production they are REQUIRED — the app refuses to boot without them,
# because local-disk uploads do not survive a redeploy and the failure looks like working media
# records whose files all 500.
#
# R2 setup: create the bucket (keep public access OFF — Payload proxies through
# /api/media/file/... and enforces its own access control), then R2 → Manage R2 API Tokens →
# Object Read & Write, scoped to that one bucket.
S3_BUCKET=threadline-media

# R2 ignores the region but the S3 client insists on one. `auto` is Cloudflare's own answer.
S3_REGION=auto

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com — the account id from the R2 overview page.
# No bucket name in the URL and no trailing slash; the adapter appends the bucket itself.
S3_ENDPOINT=
